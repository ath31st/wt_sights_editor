rangefinderUseThousandth:b=yes
crosshairHorVertSize:p2=2,2
rangefinderProgressBarColor1:c=225,255,0,125
rangefinderProgressBarColor2:c=0,0,0,1
rangefinderTextScale:r=0.9
rangefinderVerticalOffset:r=1.8
rangefinderHorizontalOffset:r=35
detectAllyTextScale:r=0.7
detectAllyOffset:p2=12,0.09
fontSizeMult:r=0.35
lineSizeMult:r=1.0
crosshairDistHorSizeMain:p2=0.01,0.02
crosshairDistHorSizeAdditional:p2=0.005,0.003	
drawCentralLineVert:b=no
drawCentralLineHorz:b=no
distanceCorrectionPos:p2=0.035,0.10			
drawDistanceCorrection:b=yes
drawSightMask:b=yes	
crosshair_hor_ranges{}

//ballisticrangeindicators
drawUpward:b=no
distancePos:p2=0.00508,0
move:b=yes
crosshairDistHorSizeMain:p2=0,0
textPos:p2=-0.00001,0
textAlign:i=1
textShift:r=0.01
drawAdditionalLines:b=no
crosshairDistHorSizeAdditional:p2=0.0,0.0
drawDistanceCorrection:b=no

crosshair_distances{
distance{distance:p3=400,4,0.0027;textPos:p2=0,0;}
distance{distance:p3=800,8,-0.004;textPos:p2=0.024,0;}
distance{distance:p3=1200,12,0.0027;textPos:p2=0,0;}
distance{distance:p3=1600,16,-0.004;textPos:p2=0.03,0;}
distance{distance:p3=2000,20,0.0027;textPos:p2=0,0;}
distance{distance:p3=2400,24,-0.004;textPos:p2=0.03,0;}
distance{distance:p3=2800,28,0.0027;textPos:p2=0,0;}
distance{distance:p3=3200,32,-0.004;textPos:p2=0.03,0;}
distance{distance:p3=3600,36,0.0027;textPos:p2=0,0;}
distance{distance:p3=4000,40,-0.004;textPos:p2=0.03,0;}

}

drawLines{
line{
line:p4=0.0,0.5,0.0,400
move:b=no
thousandth:b=yes
}

line{
line:p4=2.1,0.0,0.9,0.0
move:b=no
thousandth:b=yes
}
line{
line:p4=-2.1,0.0,-0.9,0.0
move:b=no
thousandth:b=yes
}

}

drawCircles{
circle{//0m
segment:p2=0,360;
pos:p2=0,0;
diameter:r=0.01;
size:r=1.8;
move:b=no;
thousandth:b=yes;
}
}

